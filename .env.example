# Copia questo file in .env e riempi i valori. Il .env non va su GitHub.

# Database: in locale mongod, in produzione la connection string di MongoDB Atlas
MONGO_URI=mongodb://localhost:27017/gestione-banca

# Chiave di cifratura dei dati delle carte (32 byte in esadecimale).
# Deve restare la stessa, altrimenti i dati gia salvati diventano illeggibili.
CARD_ENCRYPTION_KEY=

# URL pubblici: servono a costruire i link nelle email
BACKEND_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:4200

# SMTP per le email di conferma e di reset password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
